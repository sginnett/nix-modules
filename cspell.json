{
  "dictionaryDefinitions": [
    {
      "name":"custom-words",
      "path":"./.cspell/custom-words.txt",
      "addWords":true
    },
    {
      "name":"nix",
      "path":"./.cspell/nix.txt",
      "addWords":true
    },
    {
      "name":"vim",
      "path":"./.cspell/vim.txt",
      "addWords":true
    },
    {
      "name":"vim-plugins",
      "path":"./.cspell/vim-plugins.txt",
      "addWords":true
    }
  ],
  "dictionaries": ["custom-words"],
  "languageSettings":[
    {
      "locale":"*",
      "languageId":"vim,lua",
      "allowCompoundWords":true,
      "dictionaries":["vim", "vim-plugins"]
    },
    {
      "locale":"*",
      "languageId":"nix",
      "dictionaries":["nix", "vim-plugins"]
    }
  ]
}
